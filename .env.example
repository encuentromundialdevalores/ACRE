# ── Base de datos (PostgreSQL 16 local o Neon) ─────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/acre_platform

# ── Auth.js ────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=cambia-este-valor
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Modo de datos: real | demo ─────────────────────────────────────────────
DATA_MODE=demo

# ── INEGI / DENUE (token gratuito: https://www.inegi.org.mx/app/desarrolladores/) ──
INEGI_DENUE_TOKEN=

# ── Google Maps Platform (habilita Geocoding API y Places API (New)) ───────
GOOGLE_MAPS_API_KEY=

# ── Atlas Nacional de Riesgos (ArcGIS REST, sin credenciales) ──────────────
ANR_BASE_URL=https://rmgir.proyectomesoamerica.org/server/rest/services/ANR
ANR_SEISMIC_LAYER=Fenomenos_Geologicos/MapServer/467
ANR_LANDSLIDE_SERVICE=Fenomenos_Geologicos/MapServer
ANR_LANDSLIDE_LAYERS=382,383,384,385,386
ANR_FLOOD_LAYER=Fenomenos_Hidrometeorologicos/MapServer/52

# ── Conectores ─────────────────────────────────────────────────────────────
CONNECTOR_TIMEOUT_MS=30000
CONNECTOR_CACHE_TTL_HOURS=24

# ── Almacenamiento de documentos: local | vercel-blob ──────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=15

# ── Semilla inicial (solo scripts/seed.ts) ─────────────────────────────────
SEED_ADMIN_EMAIL=admin@acre.local
SEED_ADMIN_PASSWORD=Admin1234!
